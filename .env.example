# 复制为 .env.local 后按需填写。不要把真实的 .env.local 提交到 Git。

# —— 数据存储 ——
# 不填：使用本地文件 data/local-db.json（适合本机开发 / 自己的服务器）
# 填写：使用 Supabase（适合部署到 Vercel 等无持久磁盘的平台）
SUPABASE_URL=
# 仅在服务端使用，绝不能暴露到浏览器，绝不能提交到 Git
SUPABASE_SERVICE_ROLE_KEY=

# —— 简单写入口令（可选）——
# 设置后，提交会后记录 / 修改本周例会时需要输入这个口令。
# 不设置则任何打开网站的人都可以写入（适合内网或早期试用）。
EOE_WRITE_CODE=
